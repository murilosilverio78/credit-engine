# Include this block in the existing Caddyfile on the Brazilian VPS.
# CNDT_PROXY_TOKEN comes from Caddy's own protected environment, never source.
certidoes.murilosilverio.ia.br {
    @sem_token not header X-Proxy-Token {$CNDT_PROXY_TOKEN}
    respond @sem_token "unauthorized" 401

    reverse_proxy 127.0.0.1:8113
}
