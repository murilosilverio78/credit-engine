# Acrescente este bloco ao Caddyfile existente no VPS brasileiro.
# A autenticação (header X-Proxy-Token, comparação em tempo constante) é feita
# pelo próprio serviço, que responde 401 sem token válido; por isso o Caddy não
# precisa conhecer o segredo.
certidoes.murilosilverio.ia.br {
    request_body {
        max_size 4KB
    }
    reverse_proxy 127.0.0.1:8113
}
