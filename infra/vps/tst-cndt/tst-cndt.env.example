# Copy to /etc/tst-cndt.env; do not commit the real file.
# sudo install -o root -g tstcndt -m 600 /dev/null /etc/tst-cndt.env
TWOCAPTCHA_API_KEY=replace-with-secret
CNDT_PROXY_TOKEN=replace-with-a-long-random-secret
CNDT_STATE_DIR=/var/lib/tst-cndt
CNDT_CAPTCHA_TIMEOUT_SECONDS=120
CNDT_PORTAL_TIMEOUT_MS=30000
CNDT_MAX_CAPTCHA_ATTEMPTS=3
CNDT_CACHE_SAFETY_DAYS=7
